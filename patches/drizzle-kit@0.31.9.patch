diff --git a/api.js b/api.js
index 3aafc5b45a9e264353ae3e8cc86b6b2b9097cc2c..7b9318361fe498c8aef2da8100cf374de0453908 100644
--- a/api.js
+++ b/api.js
@@ -75217,7 +75217,16 @@ var pushSchema = async (imports, drizzleInstance, schemaFilters, tablesFilter, e
   );
   const db = {
     query: async (query, params) => {
-      const res = await drizzleInstance.execute(sql.raw(query));
+      // Preserve PostgreSQL positional parameters during schema introspection.
+      const statement = params?.length
+        ? sql.join(query.split(/(\$\d+)/g).map((part) => {
+            if (!/^\$\d+$/.test(part)) return sql.raw(part);
+            const index = Number(part.slice(1)) - 1;
+            if (index < 0 || index >= params.length) throw new Error("Missing introspection query parameter");
+            return sql`${params[index]}`;
+          }), sql.raw(""))
+        : sql.raw(query);
+      const res = await drizzleInstance.execute(statement);
       return res.rows;
     }
   };

{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "https://vndrly.ai",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ASKV_TIMING": "1",
        "EXPO_PUBLIC_DOMAIN": "https://vndrly.ai",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "node": "22.14.0",
      "pnpm": "9.15.9",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "https://vndrly.ai",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "image": "sdk-54",
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "askv-testflight": {
      "extends": "production",
      "distribution": "store",
      "channel": "askv-testflight",
      "env": {
        "EXPO_PUBLIC_ASKV_TIMING": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "v@vndrly.ai",
        "ascAppId": "6771456209",
        "appleTeamId": "CM253WWQW2"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}

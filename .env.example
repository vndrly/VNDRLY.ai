# Copy to `.env.local` and fill in the password from your Supabase project settings.
# VNDRLY uses ONE Postgres database — Supabase — for local dev and production.
#
# Dashboard: https://supabase.com/dashboard/project/bihjmgbdzbhcnsuhzzwo

SUPABASE_PROJECT_REF=bihjmgbdzbhcnsuhzzwo
SUPABASE_URL=https://bihjmgbdzbhcnsuhzzwo.supabase.co

# Object storage (Supabase Storage). Get the service role key from:
# Supabase Dashboard → Project Settings → API → service_role (secret)
# Without this, uploads fall back to .local/object-storage/ on disk.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=vndrly-objects
# Maximum accepted upload size in bytes (defaults to 25 MiB)
# SUPABASE_STORAGE_MAX_UPLOAD_BYTES=26214400

# Optional: public API base for absolute upload URLs (defaults to request host)
# PUBLIC_API_BASE=https://vndrly.ai
# LOCAL_OBJECT_DIR=C:/path/to/object-storage

# Direct connection — Linux / macOS with IPv6 (optional on Windows)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.bihjmgbdzbhcnsuhzzwo.supabase.co:5432/postgres

# Windows desktop dev — transaction pooler on port 6543 (host is often aws-1-us-west-2)
DATABASE_URL=postgresql://postgres.bihjmgbdzbhcnsuhzzwo:YOUR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Optional direct/session connection for Postgres LISTEN/NOTIFY realtime buses.
# Set this when DATABASE_URL uses a transaction pooler; leave blank to reuse DATABASE_URL.
# LISTEN_NOTIFY_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.bihjmgbdzbhcnsuhzzwo.supabase.co:5432/postgres

PORT=8080
BASE_PATH=/
VITE_API_PROXY_TARGET=http://localhost:8080
SESSION_SECRET=local-dev-session-secret-change-in-production

# Public web app origin (deep links, QR codes, email CTAs when enabled)
# PUBLIC_APP_URL=http://localhost:5173
# APP_BASE_URL=http://localhost:5173

# Assistant — set real values for Ask V / signup assistant features
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# AskV voice input (OpenAI Whisper STT — optional)
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# AskV market data tools (optional — tools return clear errors when unset)
# FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY
# ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY

# AskV route estimates / shared visual maps provider (Mapbox free tier token)
# MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN
# VITE_MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN

# Twilio messaging (optional). Local dev can also load these from:
# C:\Users\john\OneDrive\Documents\DEV\API Keys and Secrets\Twilio_API_Key.env
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_SECRET=YOUR_TWILIO_API_KEY_SECRET
# TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_SMOKE_TO=+15557654321

# SendGrid email (optional). Local dev can also load these from:
# C:\Users\john\OneDrive\Documents\DEV\API Keys and Secrets\SendGrid_API_Key.env
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=support@vndrly.ai
# SENDGRID_FROM_NAME=VNDRLY
# SENDGRID_REPLY_TO=support@vndrly.ai
# SENDGRID_SANDBOX_MODE=false

# iOS / Expo — API base URL (mobile does NOT connect to Postgres directly)
EXPO_PUBLIC_DOMAIN=https://vndrly.ai

# GoDaddy VPS deploy (scripts/godaddy-deploy.mjs) also reads these from .env.local
OPS_ALERT_EMAIL=admin@vndrly.ai

# Camera playback broker. Use the same long random value on the VNDRLY API and
# each authorized site gateway; never commit the real value.
# CAMERA_PLAYBACK_SIGNING_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Site-gateway-only settings (normally stored in its service environment).
# VNDRLY_CAMERA_GATEWAY_ID=00000000-0000-0000-0000-000000000000
# VNDRLY_CAMERA_GATEWAY_TOKEN=ONE_TIME_ENROLLMENT_TOKEN
# CAMERA_GATEWAY_PUBLIC_URL=https://camera-gateway.example.com
# CAMERA_GATEWAY_CONFIG=C:\ProgramData\VNDRLY\camera-gateway.json
# CAMERA_GATEWAY_PORT=8788
# CAMERA_ONVIF_DISCOVERY=1

# PRODUCTION_HEALTH_URL=https://vndrly.ai/api/healthz

# Keep pnpm-lock.yaml + pnpm-workspace.yaml — EAS needs them for install.
# Include all workspace packages referenced by the lockfile (artifacts/* + lib/*).

.pnpm-store
.local
.cache
.codex
.cursor
.vs
.tmp_*
.tmp_combined*
**/*.err.log
eval-summary.json
tsconfig.zip
lib/db/drizzle

docs
snapshots
.github

# Preserve workspace packages; omit generated Rust build artifacts.
**/src-tauri/target

.env
.env.local
.env.*.local

node_modules

# Web-only assets (workspace packages remain available to pnpm).
attached_assets
artifacts/vndrly-mobile/.expo-smoke-export

# Leftover export archives and design sources — never needed on EAS.
**/*.zip
**/*.psd

# Fetch and verify pinned native libraries during pod install.
artifacts/vndrly-mobile/modules/askv-wake/ios/vendor

# Local credential files and signing material
.env.*
!.env.example
*.env
*.p8
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
API Keys and Secrets/

# Local build and test output
dist
coverage
*.tsbuildinfo
